# Copy to .env and edit. NEVER commit a real .env. No paid API keys are used
# anywhere in this project — Laya and Ollama both run 100% locally.

# --- Laya (Model A: decisions) ---
LAYA_MODEL_ID=convaiinnovations/laya-multilingual
LAYA_DEVICE=auto
LAYA_MAX_LEN=1024
LAYA_ENABLED=true

# --- Ollama (Model B: creative generation) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=0

# --- Whisper ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# --- Processing ---
MAX_CLIPS=10
MIN_CLIP_SCORE=55
MIN_CLIP_DURATION=15
PREFERRED_MAX_DURATION=60
MAX_CLIP_DURATION=180
CLIP_PADDING_BEFORE=0.4
CLIP_PADDING_AFTER=0.6
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
DEFAULT_LANGUAGE=auto
SUBTITLE_THEME=dynamic

# --- Paths (relative to project root unless absolute) ---
DATA_DIR=data
